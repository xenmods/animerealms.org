{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Anime Realms",
  "version": "0.1.0",
  "identifier": "org.animerealms.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:39282/splash",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anime Realms",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "visible": true
      }


    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "standalone/**/*",
      "binaries/node.exe"
    ],

    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}


