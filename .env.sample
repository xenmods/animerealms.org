# Database (Required)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"

# Authentication (Required)
AUTH_SECRET="generate-a-secure-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# AniList OAuth Client (Required for AniList login and tracking)
# Create client at: https://anilist.co/settings/developer
# Redirect URI: http://localhost:3000/api/auth/callback/anilist
ANILIST_ID=""
ANILIST_SECRET=""

# M3U8 CORS Stream Proxy (Required for video stream playback)
# Example: https://your-m3u8-proxy.example.com
NEXT_PUBLIC_PROXY_URL=""

# TMDB API (Optional - for additional metadata and logos)
TMDB_API_KEY=""
